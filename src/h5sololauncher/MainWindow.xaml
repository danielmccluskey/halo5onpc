<Window x:Class="H5SoloLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="h5sololauncher" Width="610" Height="740" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,12">
                <TextBlock Text="h5sololauncher" FontSize="24" Margin="0,0,0,4" />
                <TextBlock Text="Osiris and Blue Team" Margin="0,0,0,20" />
                <TextBlock Text="{Binding Status}" FontSize="15" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />
                <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Checking Forge" />
                <Button Content="Find Halo in Store" Click="FindHalo_Click" HorizontalAlignment="Left"
                        Visibility="{Binding NeedsHaloApp, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,12" />
                <Separator Margin="0,0,0,16" />
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="C_hoose…" Click="ChooseCache_Click" IsEnabled="{Binding Cache.CanChoose}" AutomationProperties.Name="Choose cache folder" Margin="12,0,0,0" />
                    <TextBlock Text="Cache folder" VerticalAlignment="Center" FontSize="16" />
                </DockPanel>
                <TextBox Text="{Binding Cache.Directory, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Cache folder" FontSize="12" />
                <TextBlock Text="{Binding Cache.Space}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />
                <TextBlock Text="Choose an existing cache to play without a dump. The launcher gives Forge read access and updates paths automatically." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                <DockPanel LastChildFill="True" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="_Choose…" Click="ChooseCampaign_Click" IsEnabled="{Binding CanChooseCampaignFolder}" AutomationProperties.Name="Choose campaign dump folder" Margin="12,0,0,0" />
                    <TextBlock Text="Dump (optional — build or repair)" VerticalAlignment="Center" FontSize="16" />
                </DockPanel>
                <TextBox Text="{Binding Campaign.Directory, Mode=OneWay}" Style="{StaticResource SelectableText}" AutomationProperties.Name="Campaign dump folder" FontSize="12" />
                <TextBlock Text="{Binding Campaign.Status}" TextWrapping="Wrap" Margin="0,4,0,4" />
                <TextBlock Text="{Binding Campaign.Message}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding Campaign.IsChecking, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Checking campaign dump" />
                <TextBlock Text="{Binding Cache.PreparationStatus}" FontSize="16" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding Cache.PreparationMessage}" Margin="0,6,0,12" TextWrapping="Wrap" />
                <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding Cache.Percent, Mode=OneWay}" IsIndeterminate="{Binding Cache.IsIndeterminate}"
                             Visibility="{Binding Cache.IsWorking, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Campaign preparation progress" Margin="0,0,0,12" />
                <WrapPanel Margin="0,0,0,18">
                    <Button Content="{Binding Cache.PrimaryLabel}" Click="Play_Click" IsEnabled="{Binding Cache.CanPrimary}" IsDefault="True" MinWidth="140" Margin="0,0,8,4" />
                    <Button Content="{Binding Cache.PauseLabel}" Click="Pause_Click" IsEnabled="{Binding Cache.CanPause}" Margin="0,0,0,4" />
                </WrapPanel>
                <Expander Header="Options and diagnostics">
                    <StackPanel Margin="0,12,0,0">
                        <Label Content="Voice _language" Target="{Binding ElementName=VoiceLanguage}" Padding="0,0,0,4" />
                        <ComboBox x:Name="VoiceLanguage" ItemsSource="{Binding Cache.Languages}" SelectedItem="{Binding Cache.SelectedLanguage}"
                                  IsEnabled="{Binding Cache.CanChooseLanguage}" AutomationProperties.Name="Voice language" MinHeight="30" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding LaunchStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LaunchMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,8" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Start Forge" Click="StartForge_Click" IsEnabled="{Binding CanStartForge}" Margin="0,0,8,4" />
                            <Button Content="Stop waiting" Click="StopForgeStartup_Click" IsEnabled="{Binding CanStopForgeStartup}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Recheck dump" Click="RecheckCampaign_Click" IsEnabled="{Binding CanRecheckCampaignFolder}" Margin="0,0,8,4" />
                            <Button Content="Prepare cache only" Click="Prepare_Click" IsEnabled="{Binding Cache.CanPrepare}" Margin="0,0,8,4" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Cache.Status}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Cache.Message}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />
                        <TextBlock Text="{Binding Cache.ForgeStatus}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Cache.ForgeMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />
                        <TextBlock Text="{Binding Campaign.SettingsNotice}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Show plan" Click="ShowPlan_Click" IsEnabled="{Binding Cache.CanOpenPlan}" Margin="0,0,8,4" />
                            <Button Content="Show Forge report" Click="ShowForgeReport_Click" IsEnabled="{Binding Cache.CanOpenForgeReport}" Margin="0,0,8,4" />
                            <Button Content="Show input manifest" Click="ShowInputs_Click" IsEnabled="{Binding Cache.CanOpenInputs}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <TextBox Text="{Binding Details, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="Diagnostic details" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding CopyFeedback}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6" />
            <WrapPanel>
                <Button Content="Check _Forge again" IsEnabled="{Binding CanCheck}" Click="Check_Click" Margin="0,0,8,0" />
                <Button Content="Copy _details" IsEnabled="{Binding CanCopy}" Click="Copy_Click" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
